# Local environment files and secrets. Keep safe templates versioned.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/secrets/
**/*.secrets.json
**/*.local.json

# Private keys and local certificates
*.pem
*.key
*.pfx
*.p12

# .NET / IDE outputs
**/bin/
**/obj/
**/.vs/
**/.idea/
**/*.user
**/*.suo
**/*.userosscache
**/*.sln.docstates

# Node, frontend build output, and package-manager logs
**/node_modules/
**/dist/
**/dist-ssr/
**/.output/
**/.vinxi/
**/.tanstack/
**/.nitro/
**/.wrangler/
**/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test output and local browser state
**/TestResults/
**/coverage/
**/playwright-report/
**/test-results/
**/auth-state/

# Logs, temporary files, and local database files
**/logs/
*.log
*.tmp
*.db
*.sqlite
*.sqlite3

# Downloaded Stockfish executable (install/download separately; do not commit binaries)
/backend/tools/stockfish/*.exe

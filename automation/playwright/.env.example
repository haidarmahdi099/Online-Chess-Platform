E2E_FRONTEND_URL=http://localhost:3000
E2E_API_URL=http://localhost:5272

# Use dedicated, email-verified test accounts. Never use production accounts.
E2E_PLAYER1_USERNAME=
E2E_PLAYER1_PASSWORD=
E2E_PLAYER2_USERNAME=
E2E_PLAYER2_PASSWORD=

# Optional imported puzzle fixture; moves are UCI, comma-separated.
E2E_PUZZLE_ID=
E2E_PUZZLE_SOLUTION=
E2E_PUZZLE_WRONG_MOVES=

# Optional tournament manager account with the Admin role.
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

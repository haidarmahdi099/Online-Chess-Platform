# Copy this file to .env and fill in the values. Never commit .env.
# Load it into the current PowerShell session with:  . .\scripts\Load-Env.ps1

# --- PostgreSQL ---
# Run scripts/init-databases.sql once to create the role and databases below.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_DATABASE_PASSWORD
IDENTITY_DATABASE_NAME=chessplatform_identity
GAME_DATABASE_NAME=chessplatform_game
PUZZLE_DATABASE_NAME=chessplatform_puzzles
RATING_DATABASE_NAME=chessplatform_rating
TOURNAMENT_DATABASE_NAME=chessplatform_tournaments

# --- Secrets shared by the services ---
# Generate each with:  [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
INTERNAL_TOURNAMENT_KEY=CHANGE_ME_USE_A_SEPARATE_RANDOM_KEY
# Direct Identity API URL used only by Game.Api for trusted challenge policy checks.
IDENTITY_API_BASE_URL=http://localhost:5170/

# --- Password-reset email (optional locally: without these the reset link is only logged) ---
BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
BREVO_SENDER_EMAIL=no-reply@example.com
SIGNALR_REDIS_CONNECTION_STRING=localhost:6379
SIGNALR_REDIS_CHANNEL_PREFIX=ChessPlatform

# --- Public backend Gateway and frontend origins ---
GATEWAY_PORT=5272
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Stockfish (optional for local development; required for engine analysis) ---
# Set this to the full path of the extracted Stockfish Windows executable.
# STOCKFISH_PATH=C:\Tools\Stockfish\stockfish-windows-x86-64.exe

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PuzzleDatabase": "Host=localhost;Port=5432;Database=chessplatform_puzzles;Username=chessplatform_app"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "ChessPlatform.Identity",
    "Audience": "ChessPlatform"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "PuzzleAttemptedTopic": "puzzle.attempted",
    "OutboxPollIntervalMs": 1000,
    "OutboxBatchSize": 50
  },
  "Database": {
    "MigrateOnStartup": true
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RatingDatabase": "Host=localhost;Port=5432;Database=chessplatform_rating;Username=chessplatform_app"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "rating-service",
    "GameFinishedTopic": "game.finished",
    "PuzzleAttemptedTopic": "puzzle.attempted",
    "DeadLetterTopic": "rating.deadletter",
    "MaxProcessingAttempts": 5,
    "RetryDelaySeconds": 2
  },
  "Database": {
    "MigrateOnStartup": true
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TournamentDatabase": "Host=localhost;Port=5432;Database=chessplatform_tournaments;Username=chessplatform_app"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "ChessPlatform.Identity",
    "Audience": "ChessPlatform"
  },
  "InternalServices": {
    "TournamentKey": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "tournament-service",
    "GameFinishedTopic": "game.finished",
    "TournamentEventsTopic": "tournament.events"
  },
  "GameService": {
    "BaseUrl": ""
  },
  "Tournament": {
    "BackgroundWorkersEnabled": true,
    "MaintenanceIntervalSeconds": 10
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
